# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local (SQLite):
DATABASE_URL=file:./payload.db

# Production on Vercel (Neon Postgres free tier):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob — Hobby free tier (~1 GB storage, 2k uploads/mo).
# Connect a Blob store in Vercel Dashboard → token is auto-injected as:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Without this token, sell/landlord photos save in the browser (IndexedDB) only.

# Optional site URL (used later for sitemap/metadata)
# NEXT_PUBLIC_SITE_URL=https://www.2percentcompany.in
