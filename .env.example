# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local (SQLite):
DATABASE_URL=file:./payload.db

# Production on Vercel (Neon Postgres free tier):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob (auto-set when you connect a Blob store on Vercel; ~1GB free)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional site URL (used later for sitemap/metadata)
# NEXT_PUBLIC_SITE_URL=https://www.2percentcompany.in
